// The event log (ticket_event) is the source of truth; trip state and
// segment stats are derived caches of it. See devpost/spec.md > Data Model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Network ──────────────────────────────────────────────

model Stop {
  id         String      @id
  name       String
  routeStops RouteStop[]

  @@map("stop")
}

/// One per direction.
model Route {
  id          String      @id
  name        String
  reverseOfId String?     @map("reverse_of_id")
  reverseOf   Route?      @relation("Reverse", fields: [reverseOfId], references: [id])
  reverses    Route[]     @relation("Reverse")
  stops       RouteStop[]
  journeys    Journey[]

  @@map("route")
}

model RouteStop {
  routeId   String @map("route_id")
  seq       Int
  stopId    String @map("stop_id")
  /// timetable minutes from departure
  offsetMin Int    @map("offset_min")
  route     Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop      Stop   @relation(fields: [stopId], references: [id])

  @@id([routeId, seq])
  @@index([stopId, routeId, seq])
  @@map("route_stop")
}

/// Directed stop-to-stop edge, derived from consecutive route stops.
model Segment {
  id         String @id @default(cuid())
  fromStopId String @map("from_stop_id")
  toStopId   String @map("to_stop_id")

  stats SegmentStat[]

  @@unique([fromStopId, toStopId])
  @@map("segment")
}

enum StatBucket {
  am_peak
  midday
  pm_peak
  off
  all

  @@map("stat_bucket")
}

/// Learned typical travel time per segment and time-of-day bucket. Derived from ticket_event.
model SegmentStat {
  segmentId      String     @map("segment_id")
  bucket         StatBucket
  typicalSec     Float      @map("typical_sec")
  samples        Int
  rejected       Int        @default(0)
  /// consecutive same-side outliers; at 3 their mean becomes the new normal
  pendingCount   Int        @default(0) @map("pending_count")
  pendingMeanSec Float      @default(0) @map("pending_mean_sec")
  segment        Segment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([segmentId, bucket])
  @@map("segment_stat")
}

// ── Fleet / trust ────────────────────────────────────────

model Bus {
  id       String    @id
  regNo    String    @unique @map("reg_no")
  emitters Emitter[]
  journeys Journey[]

  @@map("bus")
}

model Emitter {
  id        String        @id
  busId     String        @map("bus_id")
  /// AES-256-GCM with EMITTER_KEY_ENC_KEY; HMAC verification needs the secret itself
  secretEnc String        @map("secret_enc")
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(3)
  bus       Bus           @relation(fields: [busId], references: [id])
  events    TicketEvent[]

  @@map("emitter")
}

// ── Operations ───────────────────────────────────────────

/// A timetabled departure; repeats every service day.
model Journey {
  id           String @id
  routeId      String @map("route_id")
  busId        String @map("bus_id")
  /// minutes after midnight, service time zone
  departureMin Int    @map("departure_min")
  route        Route  @relation(fields: [routeId], references: [id])
  bus          Bus    @relation(fields: [busId], references: [id])
  trips        Trip[]

  @@index([busId, departureMin])
  @@map("journey")
}

enum TripStatus {
  scheduled
  active
  completed

  @@map("trip_status")
}

/// A journey on one service day. Created lazily by ingest.
model Trip {
  id          String        @id @default(cuid())
  journeyId   String        @map("journey_id")
  /// YYYY-MM-DD in the service time zone
  serviceDate String        @map("service_date")
  status      TripStatus    @default(scheduled)
  lastSeq     Int?          @map("last_seq")
  lastStopId  String?       @map("last_stop_id")
  anchorAt    DateTime?     @map("anchor_at") @db.Timestamptz(3)
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  journey     Journey       @relation(fields: [journeyId], references: [id])
  events      TicketEvent[]

  @@unique([journeyId, serviceDate])
  @@map("trip")
}

/// Append-only. The source of truth: trip state and learned times can be rebuilt by folding it.
model TicketEvent {
  id             String   @id @default(cuid())
  emitterId      String   @map("emitter_id")
  idempotencyKey String   @map("idempotency_key")
  tripId         String?  @map("trip_id")
  stopId         String   @map("stop_id")
  /// device clock: when the ticket was cut
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  emitter        Emitter  @relation(fields: [emitterId], references: [id])
  trip           Trip?    @relation(fields: [tripId], references: [id])

  @@unique([emitterId, idempotencyKey])
  @@index([tripId, occurredAt])
  @@map("ticket_event")
}

// ── Alerts (no accounts: a device is a browser's push subscription) ──

model Device {
  id         String   @id @default(cuid())
  /// the push service URL for this browser; unique per subscription
  endpoint   String   @unique
  p256dh     String
  auth       String
  /// sha256 of the secret the browser keeps; proves "these alerts are mine"
  secretHash String   @map("secret_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  alerts     Alert[]

  @@map("device")
}

/// Notify me for one journey on one day, at the rider's stop. Timers are re-armed from these on boot.
model Alert {
  id             String    @id @default(cuid())
  deviceId       String    @map("device_id")
  journeyId      String    @map("journey_id")
  serviceDate    String    @map("service_date")
  fromStopId     String    @map("from_stop_id")
  toStopId       String    @map("to_stop_id")
  /// link back to the journey screen the rider set it from
  url            String
  sentThresholds Int[]     @default([]) @map("sent_thresholds")
  lastLateBucket Int       @default(0) @map("last_late_bucket")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, journeyId, serviceDate])
  @@index([journeyId, serviceDate])
  @@map("alert")
}
