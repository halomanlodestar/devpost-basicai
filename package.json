{
  "name": "ai-basics",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@app/api' --filter '@app/web' dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter '@app/db' generate",
    "db:migrate": "bun run --filter '@app/db' migrate",
    "db:seed": "bun run --filter '@app/db' seed",
    "db:reset-learning": "bun run --filter '@app/db' reset-learning",
    "db:rekey": "bun run --filter '@app/db' rekey",
    "replay": "bun --env-file=scripts/replay/.env scripts/replay/index.ts",
    "deploy:api": "bun scripts/deploy/deploy-api.ts",
    "db:migrate:deploy": "bun run --filter '@app/db' migrate:deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
